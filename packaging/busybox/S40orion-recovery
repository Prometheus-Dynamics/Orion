#!/bin/sh
# orion-recovery, the comm core alone, for an initramfs or a flasher image with BusyBox init.
# Installed as /etc/init.d/S40orion-recovery in place of S40orion-comm (an image has one or the
# other, and no S41orion-node). Settings: /etc/orion/orion.conf, as orion-recovery.conf.example
# in packaging/busybox shows; with no file it listens for SSH on port 22 with security off.
NAME=orion-recovery
MODE=recovery
PIDFILE=/run/$NAME.pid
LOG=${SUPERVISE_LOG:-/var/log/$NAME.log}

prepare() {
    umask 0007
    # In RAM on a flasher: the state directory, and with it the host key, lasts one boot.
    mkdir -p /run/orion /var/lib/orion
    # The socket's group, as for the comm core; a flasher image may have no orion group.
    grep -q '^orion:' /etc/group 2>/dev/null || return 0
    chown root:orion /run/orion
    chmod 0750 /run/orion
}

running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
    if running; then
        echo "$NAME: already running"
        return 0
    fi
    prepare
    # The supervisor in the background, its output appended to the log.
    /usr/lib/orion/orion-supervise "$MODE" >> "$LOG" 2>&1 < /dev/null &
    echo $! > "$PIDFILE"
    echo "$NAME: started"
}

stop() {
    if ! running; then
        rm -f "$PIDFILE"
        echo "$NAME: not running"
        return 0
    fi
    pid=$(cat "$PIDFILE")
    # The supervisor gives the service 30 s to stop, then kills it.
    kill -TERM "$pid"
    waited=0
    while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 35 ]; do
        sleep 1
        waited=$((waited + 1))
    done
    rm -f "$PIDFILE"
    echo "$NAME: stopped"
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) if running; then echo "$NAME: running"; else echo "$NAME: stopped"; exit 1; fi ;;
    *) echo "usage: $0 start|stop|restart|status" >&2; exit 2 ;;
esac
