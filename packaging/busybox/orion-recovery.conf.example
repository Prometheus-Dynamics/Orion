# /etc/orion/orion.conf for orion-recovery in a flasher image: a RAM-only initramfs whose
# board is reached over a USB gadget, so that flashing it is an ordinary update. The
# environment overrides a key: `node.name` is ORION_NODE_NAME.

# This board's name while it is in the flasher.
node.name = flasher

# The USB link. Only its name is set here: the program that sets up the gadget opens the
# FunctionFS endpoints and hands them to the comm core at run time (a LinkOffer), and again
# after the cable comes back.
links.usb = usb

# SSH, for a person, on the gadget's network interface and no other, whatever address the
# image gives it: `usb0` is the usual name of a gadget's network function; name the one the
# image makes. The comm core starts before the gadget does: SSH waits for the interface and
# opens on it when it comes up. Recovery, if the comm core ends up there, keeps to it too.
ssh.interface = usb0
ssh.listen = 0.0.0.0:22

# Security off: whoever is on the other end of the cable may do anything, root included, as
# they may with the boot ROM that started this image. Fresh in RAM each boot, the flasher has
# no trust store to check against. This is safe only because the cable is the only way in:
# the Orion link is the USB link and SSH is on the gadget's interface. Never use this file on
# a board on a shared network, or in an image that brings up Ethernet or Wi-Fi with Orion
# listening there: anyone on that network would own the board.
security = off

# The state directory is in RAM: the host key and the board's key last one boot.
state.dir = /var/lib/orion
