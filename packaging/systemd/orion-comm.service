# The comm core: every way into the board. Installed as /usr/lib/systemd/system/orion-comm.service.
#
# It runs as orion-comm, with the orion group, so its socket (mode 0660) is node logic's and every
# program's in that group. It is never root: a login it lets in is started by the login helper
# (orion-login.socket), the one process that may become another user. Settings are in
# /etc/orion/orion.conf. Change this unit with drop-ins, not an edited copy. See
# packaging/README.md.

[Unit]
Description=Orion comm core
Documentation=https://github.com/Prometheus-Dynamics/Orion/blob/main/packaging/README.md
After=network.target orion-login.socket
Wants=orion-login.socket
# No start limit: a unit that has failed too often would stay down, and the way into the board
# is never switched off. A crash loop keeps retrying with the backoff below.
StartLimitIntervalSec=0

[Service]
# READY=1 once every listener is up; "alive" every half watchdog from the comm core's own thread,
# so a comm core that no longer turns is restarted.
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/orion comm
WatchdogSec=30s
TimeoutStartSec=60s
TimeoutStopSec=30s

Restart=always
RestartSec=1s
RestartSteps=5
RestartMaxDelaySec=30s

User=orion-comm
Group=orion
# Logins are started by the login helper (login.helper).
Environment=ORION_LOGIN_HELPER=/run/orion-login/login.sock
# Serial links.
SupplementaryGroups=dialout
# Setting the clock (time.sync = discipline) and SSH on port 22. Nothing else.
AmbientCapabilities=CAP_SYS_TIME CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_SYS_TIME CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# /run/orion holds the socket and the rings; it is kept across a restart, so a program that
# reconnects finds what it shared. /var/lib/orion holds the comm core's keys, orion-comm's, which
# the orion group may read.
RuntimeDirectory=orion
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
StateDirectory=orion
StateDirectoryMode=0755
UMask=0007

# Sessions run in orion-login.service, not here, so nothing here follows a login.
# scripts/packaging-check.sh holds its score.
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# AF_NETLINK: interfaces for discovery. AF_CAN: CAN links. AF_PACKET is not needed.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_CAN
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
