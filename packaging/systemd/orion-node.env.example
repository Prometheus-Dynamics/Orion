# /etc/default/orion-node.env: settings for orion-node.service (single-node appliance profile).
#
# Plain KEY=value lines (systemd EnvironmentFile syntax; no `export`, no shell expansion).
# Assignments here override the Environment= defaults in the unit. Every variable is documented
# in docs/node-env.md. Restart the service after editing: `systemctl restart orion-node`.

# --- Identity ------------------------------------------------------------------------------------
# Unique per device. Leave unset to use `node.local`.
#ORION_NODE_ID=device-01
#ORION_NODE_LABELS=role=appliance

# --- Local IPC (defaults set by the unit) --------------------------------------------------------
#ORION_NODE_IPC_SOCKET=/run/orion/control.sock
#ORION_NODE_IPC_STREAM_SOCKET=/run/orion/control-stream.sock
# `same-user` (default): only processes running as the orion user may connect.
# `same-user-or-group`: also processes whose primary group is orion (Group=orion in their unit).
#ORION_NODE_LOCAL_AUTH=same-user-or-group

# --- HTTP control plane --------------------------------------------------------------------------
# Off for appliances. Builds without the `transport-http` feature only accept `off`.
ORION_NODE_HTTP_ADDR=off

# --- Runtime and memory budget -------------------------------------------------------------------
ORION_NODE_RUNTIME_WORKER_THREADS=2
ORION_NODE_RUNTIME_MAX_BLOCKING_THREADS=8
ORION_NODE_MAX_MUTATION_HISTORY=64
ORION_NODE_MAX_MUTATION_HISTORY_BYTES=262144
ORION_NODE_OBSERVABILITY_EVENT_LIMIT=64
ORION_NODE_PERSISTENCE_WORKER_QUEUE_CAPACITY=32
ORION_NODE_AUDIT_LOG_QUEUE_CAPACITY=256
# Coalesce observed/applied state writes (flash wear): at most one write per interval.
ORION_NODE_OBSERVED_PERSIST_INTERVAL_MS=5000
# glibc malloc arenas (the unit already sets 2).
#MALLOC_ARENA_MAX=2

# --- Reconcile loop ------------------------------------------------------------------------------
#ORION_NODE_RECONCILE_MS=250
#ORION_NODE_RECONCILE_BACKSTOP_MS=5000

# --- Clustering over orion+tcp (build feature `peer-tcp`) ----------------------------------------
# Listener for signed peer sync. Leave unset for a standalone node.
#ORION_NODE_PEER_ADDR=0.0.0.0:9200
# Static peers: node-id=orion+tcp://host:port|<ed25519-public-key-hex>, comma-separated.
#ORION_NODE_PEERS=device-02=orion+tcp://192.0.2.12:9200|<public-key-hex>
#ORION_NODE_PEER_AUTH=required

# --- Discovery (build feature `discovery-mdns`) --------------------------------------------------
# Needs ORION_NODE_PEER_ADDR and ORION_NODE_PEER_AUTH=required. Discovery never trusts a peer by
# itself: automatic enrollment needs the shared key. See docs/discovery.md.
#ORION_NODE_DISCOVERY=mdns
#ORION_NODE_DISCOVERY_INTERFACES=eth0
#ORION_NODE_CLUSTER=appliances
# Prefer a key file readable only by the orion user over an inline key.
#ORION_NODE_ENROLLMENT_KEY_FILE=/etc/orion/enrollment.key

# --- MCU links (build feature `link-gateway`) ----------------------------------------------------
# `;`-separated serial:<path>?... and can:<interface>?... entries; see docs/link-protocol.md.
# Serial ports need the dialout group (set in the unit); CAN interfaces must be up already.
#ORION_NODE_LINKS=serial:/dev/ttyAMA0?baud=115200&allow=sensor-board
#ORION_NODE_LINKS=serial:/dev/ttyACM0;can:can0?addresses=1-8&allow=motor-a,motor-b

# --- Logging -------------------------------------------------------------------------------------
# tracing EnvFilter syntax; logs go to stderr (the journal).
#RUST_LOG=info
#ORION_NODE_AUDIT_LOG=/var/lib/orion/audit.log
